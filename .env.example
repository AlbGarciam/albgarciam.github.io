# URL of the deployed Firebase function (see README). For local work,
# run `npm run dev:api` and use the value below in .env.local.
VITE_CONTACT_ENDPOINT=http://localhost:8787

# Firebase web app config for Analytics (Firebase console > Project settings > Your apps).
# Leave empty to keep analytics fully disabled.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
